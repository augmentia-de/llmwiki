# ============================================
# LLM Wiki — Karpathy Pattern (File-Based)
# ============================================
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env
#   nano .env

# ============================================
# Chat Model (LLM)
# ============================================

# --- OpenAI (direkt) ---
LLM_CHAT_BASE_URL=https://api.openai.com/v1
LLM_CHAT_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_CHAT_MODEL=gpt-4o

# --- OpenRouter (OpenAI-kompatibel) ---
# LLM_CHAT_BASE_URL=https://openrouter.ai/api/v1
# LLM_CHAT_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_CHAT_MODEL=openai/gpt-4o

# --- LiteLLM (Proxy) ---
# LLM_CHAT_BASE_URL=http://localhost:4000
# LLM_CHAT_API_KEY=sk-1234
# LLM_CHAT_MODEL=gpt-4o

# ============================================
# Wiki Verzeichnisse
# ============================================
# Basis-Verzeichnis für alle Wiki-Daten
LLMWIKI_BASE_DIR=${HOME}/karpathy-wiki

# Unterverzeichnisse (werden automatisch erstellt)
LLMWIKI_RAW_DIR=${HOME}/karpathy-wiki/raw
LLMWIKI_WIKI_DIR=${HOME}/karpathy-wiki/wiki

# ============================================
# Server
# ============================================
QUARKUS_HTTP_PORT=8480
