# ============================================
# LLM Wiki — Karpathy Pattern (File-Based)
# ============================================
# cp .env.example .env
# nano .env

# ============================================
# Primary Chat Model
# ============================================

# --- OpenAI (direct) ---
LLM_CHAT_BASE_URL=https://api.openai.com/v1
LLM_CHAT_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_CHAT_MODEL=gpt-4o

# --- OpenRouter (OpenAI-compatible) ---
# LLM_CHAT_BASE_URL=https://openrouter.ai/api/v1
# LLM_CHAT_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_CHAT_MODEL=openai/gpt-4o

# --- LiteLLM (local proxy) ---
# LLM_CHAT_BASE_URL=http://localhost:4000
# LLM_CHAT_API_KEY=sk-1234
# LLM_CHAT_MODEL=gpt-4o

# ============================================
# Fallback Chat Model
# Used when primary fails after all retries.
# Can be a different provider (OpenRouter, Anthropic, Ollama).
# ============================================
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=${LLM_CHAT_API_KEY}
LLM_FALLBACK_MODEL=anthropic/claude-sonnet-4-20250514

# --- Fallback: Ollama (local) ---
# LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
# LLM_FALLBACK_API_KEY=ollama
# LLM_FALLBACK_MODEL=llama3.1:8b

# ============================================
# Retry Settings
# ============================================
# Retries on primary before fallback
LLMWIKI_RETRY_MAX_ATTEMPTS=3
# Seconds between retries
LLMWIKI_RETRY_DELAY_SECONDS=30

# ============================================
# Wiki Directories
# ============================================
LLMWIKI_BASE_DIR=${HOME}/karpathy-wiki
LLMWIKI_RAW_DIR=${HOME}/karpathy-wiki/raw
LLMWIKI_WIKI_DIR=${HOME}/karpathy-wiki/wiki

# ============================================
# Server
# ============================================
QUARKUS_HTTP_PORT=8480

# ============================================
# MCP Server
# ============================================
# MCP endpoint is OFF by default. Set to 'true' to enable.
# When enabled, tools are available at:
#   SSE:  http://localhost:8480/mcp/sse
#   stdio: via stdin (when running the jar directly)
PROVIDE_MCP_ENDPOINT=false

# MCP Tools (when enabled):
#   - wikiSearch(query, category?, limit?)    — Search wiki pages
#   - wikiReadPage(slug)                      — Read full page content
#   - wikiListPages(category?)                — List all pages by category
#   - wikiReadIndex()                         — Read the full wiki index
#   - wikiReadLog()                           — Read recent activity log
#
# Claude Desktop config (~/.config/Claude/claude_desktop_config.json):
#   { "mcpServers": {
#     "llmwiki": {
#       "command": "java",
#       "args": ["-jar", "/path/to/llmwiki/target/quarkus-app/quarkus-run.jar"],
#       "env": {
#         "PROVIDE_MCP_ENDPOINT": "true",
#         "LLMWIKI_WIKI_DIR": "/home/torsten/karpathy-wiki/wiki"
#       }
#     }
#   }}
