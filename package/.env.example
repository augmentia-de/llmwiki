# ─── LLM Konfiguration ───
# OpenAI-kompatibler Endpoint (OpenRouter, Azure, LocalAI, etc.)
LLM_CHAT_BASE_URL=https://openrouter.ai/api/v1
LLM_CHAT_API_KEY=your-api-key-here
LLM_CHAT_MODEL=openai/gpt-4o-mini

# ─── Fallback LLM (optional) ───
#LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
#LLM_FALLBACK_API_KEY=your-fallback-api-key
#LLM_FALLBACK_MODEL=anthropic/claude-sonnet-4-20250514

# ─── Server ───
PORT=8080

# ─── Retry Settings ───
LLMWIKI_RETRY_MAX_ATTEMPTS=3
LLMWIKI_RETRY_DELAY_SECONDS=30
